{
    "layer": "top",
    "position": "top",

    "height": 42,
    "spacing": 0,

    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/theme",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/cpu",
        "custom/memory",
        "disk",
        "custom/network",
        "wireplumber",
        "bluetooth",
        "battery",
        "tray"
    ],

    // ============================================================
    // 主题切换（太阳 / 月亮）
    // ============================================================

    "custom/theme": {
        "exec": "~/.config/waybar/scripts/theme.sh",
        "interval": 5,
        "return-type": "json",

        "format": "{text}",

        "tooltip": true,
        "tooltip-format": "{tooltip}",

        "on-click": "~/.config/scripts/theme-toggle.sh"
    },

    // ============================================================
    // 工作区
    // ============================================================

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "urgent": ""
        },

        "persistent-workspaces": {
            "*": 5
        },

        "sort-by-number": true,
        "disable-scroll": false,

        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",

        "tooltip": true,
        "tooltip-format": "Workspace {name}"
    },

    // ============================================================
    // 当前窗口
    // ============================================================

    "hyprland/window": {
        "format": "  {}",
        "max-length": 45,

        "tooltip": true,
        "tooltip-format": "当前窗口\n{}"
    },

    // ============================================================
    // 时间
    // ============================================================

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰃭  {:%Y-%m-%d}",

        "tooltip": true,

        "tooltip-format":
            "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",

        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#89b4fa'>W{}</span>",
                "weekdays": "<span color='#f5c2e7'>{}</span>",
                "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
            }
        },

        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ============================================================
    // CPU（自定义脚本）
    // ============================================================

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "interval": 2,
        "return-type": "json",

        "format": "{text}",

        "tooltip": true,
        "tooltip-format": "{tooltip}",

        "on-click": "kitty --hold btop"
    },

    // ============================================================
    // 内存（自定义脚本）
    // ============================================================

    "custom/memory": {
        "exec": "~/.config/waybar/scripts/memory.sh",
        "interval": 2,
        "return-type": "json",

        "format": "{text}",

        "tooltip": true,
        "tooltip-format": "{tooltip}",

        "on-click": "kitty --hold btop"
    },

    // ============================================================
    // 磁盘（原生）
    // ============================================================

    "disk": {
        "interval": 30,

        "format": "󰋊  {percentage_used}%",

        "path": "/",

        "tooltip": true,

        "tooltip-format":
            "Disk\n󰋊 使用率：{percentage_used}%\n󰋊 已使用：{used}\n󰋊 总容量：{total}\n󰋊 剩余：{free}"
    },

    // ============================================================
    // 网络（自定义脚本）
    // ============================================================

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "interval": 2,
        "return-type": "json",

        "format": "{text}",

        "tooltip": true,
        "tooltip-format": "{tooltip}",

        "on-click": "nm-connection-editor"
    },

    // ============================================================
    // 音量（wireplumber / wpctl 统一）
    // ============================================================

    "wireplumber": {
        "format": "{icon}  {volume}%",

        "format-bluetooth": "{icon}  {volume}% 󰂰",
        "format-muted": "󰖁  Muted",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰚖",

            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "scroll-step": 5,

        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",

        "tooltip": true,

        "tooltip-format":
            "Audio\n󰕾 音量：{volume}%\n󰓃 输出：{desc}"
    },

    // ============================================================
    // 蓝牙
    // ============================================================

    "bluetooth": {
        "format": "󰂯",

        "format-disabled": "󰂲",
        "format-off": "󰂲",

        "format-connected": "󰂯 {num_connections}",

        "tooltip": true,

        "tooltip-format": "Bluetooth\n{status}",

        "on-click": "blueman-manager"
    },

    // ============================================================
    // 电池
    // ============================================================

    "battery": {
        "interval": 5,

        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon}  {capacity}%",

        "format-charging": "󰂄  {capacity}%",

        "format-plugged": "󰚥  {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip": true,

        "tooltip-format":
            "Battery\n󰁹 电量：{capacity}%\n󰂄 状态：{status}\n󰂅 电压：{voltage} V\n󰂎 功率：{power} W"
    },

    // ============================================================
    // 系统托盘
    // ============================================================
    "tray": {
        "icon-size": 17,
        "spacing": 6,
        "show-passive-items": false,
        "reverse-direction": false,
        "smooth-scrolling-threshold": 1
    }
}
