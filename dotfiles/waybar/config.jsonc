// ~/.config/waybar/config.jsonc
// 配色和 mongia-greeter 保持一致：Catppuccin Mocha
{
  "layer": "top",
  "position": "top",
  "height": 20,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "spacing": 4,

  "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/updates",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "custom/power"
  ],

  // ── 最左：Arch logo，点击弹出电源菜单 ──────────────────────
  "custom/arch": {
    "format": "",
    "tooltip-format": "电源菜单（关机 / 重启 / 睡眠 / 登出）",
    "on-click": "wlogout -p layer-shell || ~/.config/waybar/scripts/power-menu.sh"
  },

  // ── 左侧：工作区 + 当前窗口标题 ──────────────────────────────
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
      "urgent": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "": "桌面"
    }
  },

  // ── 中间：时钟，悬浮显示日历 ──────────────────────────────
  "clock": {
    "interval": 1,
    "format": " {:%H:%M}",
    "format-alt": " {:%Y-%m-%d %A}",
    "tooltip-format": "<big>{:%Y 年 %m 月 %d 日}</big>\n<small>{:%A}</small>\n\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#6c7086'>{}</span>",
        "weekdays": "<span color='#b4befe'><b>{}</b></span>",
        "today": "<span color='#f5c2e7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // ── 右侧：托盘 ──────────────────────────────
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  // ── pacman 更新数，悬浮列出包名（见 scripts/updates.sh） ──────
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 1800,
    "format": " {}",
    "on-click": "foot -e sudo pacman -Syu",
    "tooltip": true
  },

  // ── 音量 ──────────────────────────────
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " 静音",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}\n音量：{volume}%"
  },

  // ── 网络：wifi 名、信号强度，悬浮显示 IP 和速率 ──────────────
  "network": {
    "interface": "wl*",
    "format-wifi": " {essid}",
    "format-ethernet": " 有线",
    "format-disconnected": " 未连接",
    "format-linked": " {ifname}（无 IP）",
    "tooltip-format-wifi": "{essid}\n信号强度：{signalStrength}%\nIP：{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\nIP：{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "未连接网络",
    "on-click": "foot -e nmtui",
    "interval": 5
  },

  // ── CPU，悬浮显示各核心占用 ──────────────────────────────
  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "tooltip": true,
    "on-click": "foot -e btop"
  },

  // ── 内存，悬浮显示已用/总量 ──────────────────────────────
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "已用 {used:0.1f} GiB / 共 {total:0.1f} GiB\nswap {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
    "on-click": "foot -e btop"
  },

  // ── 电池，悬浮显示剩余时间 ──────────────────────────────
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}\n{power}W"
  },

  // ── 电源按钮（调用 wlogout 或直接执行操作，二选一） ──────────
  "custom/power": {
    "format": "",
    "tooltip-format": "电源菜单",
    "on-click": "wlogout -p layer-shell || ~/.config/waybar/scripts/power-menu.sh"
  }
}
